# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Next.js Environment
NODE_ENV=development

# Site Configuration — canonical production host (www; apex redirects to www)
NEXT_PUBLIC_SITE_URL=https://www.cloudbreakridgehomes.com
# Alias accepted by app/layout.tsx metadataBase if SITE_URL unset:
# NEXT_PUBLIC_BASE_URL=https://www.cloudbreakridgehomes.com

# Google Search Console — HTML tag verification
# In GSC: add URL-prefix property https://www.cloudbreakridgehomes.com
#   (or Domain property cloudbreakridgehomes.com via DNS TXT)
# Copy the content= value from the meta tag Google shows, e.g.:
#   <meta name="google-site-verification" content="TOKEN_HERE" />
# Paste TOKEN_HERE only into Vercel → Project → Settings → Environment Variables
#   (Production). Do not commit real tokens.
# Root layout reads either var and emits verification.google in <head>.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# GOOGLE_SITE_VERIFICATION=   # optional non-public alias (same token)

# Dr. Jan Duffy headshot (optional override). Default: Cloudflare R2
# realestatedomains-assets / shared/agent/dr-jan-duffy-headshot.jpg
# NEXT_PUBLIC_DR_JAN_DUFFY_HEADSHOT=https://pub-720ca9b7443b47be981def05abd3d7f0.r2.dev/shared/agent/dr-jan-duffy-headshot.jpg
